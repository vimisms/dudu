# Copy this file to .env and fill in real values. Never commit the real .env.

# --- LLM that powers the LangGraph agent ---
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o-mini
# If you switch agent_graph.py to Anthropic instead:
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_MODEL=claude-sonnet-4-5

# --- Filesystem MCP: the D365 / SQL / KQL knowledge-base repo it may read ---
KB_REPO_PATH=C:\campair-TraceAI

# --- Local RAG (rag_search_server.py): semantic/vector search over KB_REPO_PATH ---
# Where the local vector index is persisted (Chroma files + manifest.json).
KB_INDEX_DIR=./kb_index
# "sentence_transformers" = real local semantic embeddings (recommended, first
# use downloads the model, ~100-400MB one-time, then fully offline/no API calls).
# "tfidf" = zero-download keyword-weighted fallback, no model needed at all.
KB_EMBEDDING_BACKEND=sentence_transformers
KB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# "chroma" = recommended persistent local vector DB. "numpy" = zero-dependency
# fallback (fine up to tens of thousands of chunks, which covers this repo).
KB_VECTOR_BACKEND=chroma
# How often the background thread re-syncs the index against the repo on disk
# (seconds). Lower this if you want edits to show up faster; a full sync of
# this repo's size takes well under a second once embeddings are warm.
KB_REINDEX_INTERVAL_SECONDS=300

# --- Zomato MCP (external, remote) ---
ZOMATO_MCP_URL=https://mcp-server.zomato.com/mcp
# If Zomato requires an API key / bearer token for their MCP server, put it here.
# The exact auth scheme is not publicly documented as of this writing -- check
# Zomato's MCP/developer docs before assuming this env var name is correct.
ZOMATO_MCP_API_KEY=

# --- QuickCommerce MCP (hosted) -- grocery/product search + delivery ETA ---
# Get a key at https://quickcommerceapi.com/dashboard (sent as X-API-Key).
# Leave blank to skip this server.
QUICKCOMMERCE_API_KEY=

# --- Twilio MCP (narrowed to SMS only) ---
# Create an API key + secret in the Twilio console (Account SID is on the
# dashboard). The MCP server auths as ACCOUNT_SID/API_KEY:API_SECRET.
# All three must be set or the server is skipped.
# The old ~197-tool bloat is handled in mcp_config.json: --services/--tags
# narrow the server to the Messages resource and "only_tools" filters again on
# our side, so this now contributes ~3 tools instead of 197.
#
# An API KEY IS REQUIRED. A plain `curl -u <ACCOUNT_SID>:<AUTH_TOKEN>` works
# against Twilio's REST API, but @twilio-alpha/mcp validates the credential
# shape and rejects an auth token with "Error: Invalid AccountSid" (confirmed
# via diagnose_mcp.py). Create one at:
#   Twilio Console > Account > API keys & tokens > Create API key (Standard)
# The secret is shown once. TWILIO_AUTH_TOKEN is not used by this server.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
# The Twilio number messages are sent FROM, E.164 e.g. +17372508034. The agent
# is told this automatically, so you never have to dictate it.
TWILIO_FROM_NUMBER=

# --- Swiggy Builders Club MCP (food ordering / Instamart / Dineout) ---
# No API key: it uses OAuth 2.1 + PKCE with dynamic client registration, so the
# first connection opens a browser to sign in to your Swiggy account. Set to
# true to enable. Local/dev use needs no approval from Swiggy; production
# access requires applying with a demo video.
ENABLE_SWIGGY=false

# --- ICM MCP (remote, Azure API Management) ---
# This server uses OAuth, but Azure API Management does NOT support dynamic
# client registration -- its /register endpoint returns 404, which kills the
# flow before a browser opens. Supply a pre-registered app's client ID to skip
# registration. Get it from whoever owns the ICM MCP endpoint, or from an
# Entra ID app registration with this redirect URI:
#     http://localhost:8757/callback
ICM_OAUTH_CLIENT_ID=
ICM_OAUTH_CLIENT_SECRET=
ICM_MCP_API_KEY=

# --- Wake words ---
WAKE_WORD_ON=wake_up
WAKE_WORD_OFF=go_to_sleep

# --- Piper TTS voice model (see docs/SETUP.md for download instructions) ---
PIPER_VOICE_PATH=./models/piper/en_US-lessac-medium.onnx

# --- Whisper STT model size ---
# Prefer the ENGLISH-ONLY ".en" variants: faster AND more accurate than the
# multilingual model of the same size. tiny.en < base.en < small.en.
# The backend logs an "RTF" (real-time factor) per transcription -- if it's
# near 1.0, this model is too big for your CPU; step down a size.
WHISPER_MODEL_SIZE=base.en

# --- Voice mode ---
# "hold_to_talk" (default) -- true push-to-talk. Hold the Talk button or the
#     spacebar while speaking, release to send. The mic is open ONLY while held,
#     and release is an explicit end-of-speech signal, so there is no
#     silence-detection delay: release and it transcribes immediately.
# "push_to_talk" -- tap the mic once and it keeps listening; each utterance is
#     ended by detecting silence. Hands-free, but costs ~700ms per turn.
# "wake_word" -- classic always-on assistant: mic can stay on all day, but only
#     utterances starting with "Dudu" are acted on.
VOICE_MODE=hold_to_talk

# --- Microphone ---
# Whether the mic is live the moment DuDu starts. Default false: it stays
# muted (the input device is not even opened) until you click the mic chip,
# so it can't pick up background conversation you never opted into.
MIC_ENABLED_ON_START=false

# --- Voice responsiveness ---
# Hard cap on a single hold-to-talk recording (seconds). You end the recording
# by releasing the button, so this is only a runaway guard (e.g. a stuck key),
# not a limit on how much you can say. The old 30s cap truncated long
# instructions mid-sentence.
MAX_HOLD_S=180
# Trailing silence that ends an utterance (ms). Dead time on EVERY turn: you
# stop speaking and nothing happens until it elapses. Lower = snappier, but too
# low cuts you off at natural pauses.
WAKE_TRAILING_SILENCE_MS=700

# --- Server ---
# 127.0.0.1 keeps the agent reachable only from this machine. There is NO
# authentication on /command or /ws, and the agent can read your KB repo and
# (when those MCP servers are configured) spend money, so only change this if
# you specifically want other machines on your network to drive it.
WS_HOST=127.0.0.1
WS_PORT=8756

# --- Timeouts and memory ---
# Hard cap per task. A semantic search + a couple of read_file calls + the
# final answer routinely exceeds 90s on a cold index.
TASK_TIMEOUT_S=180
# Budget for the post-task summarizer; falls back to a truncated summary.
SUMMARY_TIMEOUT_S=25
# How many previous exchanges get replayed so follow-up questions
# ("and the second one?") resolve. 0 disables follow-ups.
HISTORY_TURNS=4

# --- MCP server loading ---
# Per-server budget for handing over the tool list. The npx-based servers
# (filesystem, twilio) may resolve/download a package first, which can exceed
# 60s on a cold cache. A timeout silently loses every tool that server has, so
# be generous. Permanent fix for the filesystem server:
#     npm i -g @modelcontextprotocol/server-filesystem
MCP_LOAD_TIMEOUT_S=150

# --- Logging ---
# Rotating log file relative to backend/ (set empty for console only).
LOG_FILE=./logs/dudu.log
LOG_LEVEL=INFO
