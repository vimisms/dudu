backend/logs/
# Cached MCP OAuth tokens are credentials; never commit them.
**/.oauth_tokens/

# Credentials and private key material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
*secrets*.json
*tokens*.json

